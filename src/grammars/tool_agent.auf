// tool_agent — the same tool registry and typing rules as tool.auf, rooted
// at a single step (AgentStep) instead of a whole multi-statement Program.
//
// This is what makes a genuine multi-turn agent loop possible: each turn
// asks the model to produce exactly one `let` or `return`, and
// `Synthesizer.status()` reports "typed" the moment *that one step* is
// complete — there is no "rest of the program" to wait for. The harness
// (benchmarks/agent.py) drives the loop: after each step it "executes" the
// tool call and calls `add_to_ctx(name, type)` on a fresh Synthesizer for
// the next step, so Γ accumulates across turns exactly like a real agent's
// growing scratchpad, with aufbau constraining every individual step against
// it — no turn can reference a variable that doesn't exist yet, or feed a
// tool the wrong-typed argument, no matter how many turns have already run.

Identifier ::= /[a-z_][a-z0-9_]*/
StringLit(str_lit) ::= /"[a-zA-Z0-9_]*"/
IntLit(int_lit) ::= /[0-9]+/

Variable(var) ::= Identifier[x]
Value ::= Variable | StringLit | IntLit

SearchCall(search_call) ::= 'search' '(' Value[arg] ')'
SummarizeCall(summarize_call) ::= 'summarize' '(' Value[arg] ')'
CountCall(count_call) ::= 'count' '(' Value[arg] ')'
FormatCall(format_call) ::= 'format' '(' Value[arg] ')'

Call ::= SearchCall | SummarizeCall | CountCall | FormatCall

LetStmt(let) ::= 'let' Identifier[name] '=' Call[value] ';'
ReturnStmt(return) ::= 'return' Value[e] ';'

AgentStep ::= LetStmt | ReturnStmt

// ===================== Typing rules =====================

x ∈ Γ
----------- (var)
Γ(x)

----------- (str_lit)
'string'

----------- (int_lit)
'int'

Γ ⊢ arg : 'string'
-------------------- (search_call)
'docs'

Γ ⊢ arg : 'docs'
-------------------- (summarize_call)
'string'

Γ ⊢ arg : 'docs'
-------------------- (count_call)
'int'

Γ ⊢ arg : 'int'
-------------------- (format_call)
'string'

Γ ⊢ value : ?τ
------------------------- (let)
Γ → Γ[name:?τ] ⊢ 'void'

Γ ⊢ e : ?A
----------- (return)
'void'
