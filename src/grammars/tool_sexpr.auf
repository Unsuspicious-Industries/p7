// tool_sexpr — the same typed tool-calling pipeline as tool.auf, in a
// completely different concrete syntax (S-expressions instead of
// semicolon-terminated statements). Same tool registry, same types, same
// typing rules — only the surface grammar differs. This is the point: aufbau
// constrains whatever syntax a task defines, so a benchmark can vary surface
// form independently of the underlying type discipline, showing the pass-rate
// benefit isn't an artifact of one particular syntax choice.
//
//   (let r (search "agents"))
//   (let s (summarize r))
//   (return s)

Identifier ::= /[a-z_][a-z0-9_]*/
StringLit(str_lit) ::= /"[a-zA-Z0-9_]*"/
IntLit(int_lit) ::= /[0-9]+/

Variable(var) ::= Identifier[x]
Value ::= Variable | StringLit | IntLit

SearchCall(search_call) ::= '(' 'search' Value[arg] ')'
SummarizeCall(summarize_call) ::= '(' 'summarize' Value[arg] ')'
CountCall(count_call) ::= '(' 'count' Value[arg] ')'
FormatCall(format_call) ::= '(' 'format' Value[arg] ')'

Call ::= SearchCall | SummarizeCall | CountCall | FormatCall

LetStmt(let) ::= '(' 'let' Identifier[name] Call[value] ')'
ReturnStmt(return) ::= '(' 'return' Value[e] ')'

Program ::= LetStmt Program | ReturnStmt

// ===================== Typing rules =====================

x ∈ Γ
----------- (var)
Γ(x)

----------- (str_lit)
'string'

----------- (int_lit)
'int'

Γ ⊢ arg : 'string'
-------------------- (search_call)
'docs'

Γ ⊢ arg : 'docs'
-------------------- (summarize_call)
'string'

Γ ⊢ arg : 'docs'
-------------------- (count_call)
'int'

Γ ⊢ arg : 'int'
-------------------- (format_call)
'string'

Γ ⊢ value : ?τ
------------------------- (let)
Γ → Γ[name:?τ] ⊢ 'void'

Γ ⊢ e : ?A
----------- (return)
'void'
