// Lamb — syntax for Lambench lambda-calculus submissions

Identifier ::= /[A-Za-z_][A-Za-z0-9_]*/

Variable(var) ::= Identifier[x]
GlobalRef(ref) ::= '@' Identifier[name]
Lambda(lambda) ::= 'λ' Identifier[param] '.' Term[body]
Paren ::= '(' Term ')'
Atom ::= GlobalRef | Variable | Lambda | Paren

SingleArg(arg) ::= Term[value]
MoreArgs(args) ::= Term[first] ',' Args[rest]
Args ::= MoreArgs | SingleArg

Application(app) ::= Atom[func] '(' Args[args] ')'
                | Application[func] '(' Args[args] ')'

Term ::= Application | Atom

Definition(def) ::= '@' Identifier[name] '=' Term[value]
EmptyProgram(empty_program) ::= ε
MoreProgram(program_tail) ::= Definition[head] ProgramTail[tail]
ProgramTail ::= EmptyProgram | MoreProgram
Program(program) ::= Definition[head] ProgramTail[tail]

// Scope rules
// Global references must refer to definitions already present in Γ. Definition
// bodies are checked before the new name is added, so forward and recursive
// references are rejected.

----------- (var)
'Term'

name ∈ Γ
----------- (ref)
Γ(name)

Γ ⊢ body : 'Term'
------------------- (lambda)
'Term'

Γ ⊢ value : 'Term'
------------------ (arg)
'Term'

Γ ⊢ first : 'Term', Γ ⊢ rest : 'Term'
--------------------------------------- (args)
'Term'

Γ ⊢ func : 'Term', Γ ⊢ args : 'Term'
-------------------------------------- (app)
'Term'

Γ ⊢ value : 'Term'
------------------ (def)
Γ → Γ[name:'Term'] ⊢ ∅

----------------------- (empty_program)
∅

Γ ⊢ head : ∅, Γ ⊢ tail : ∅
------------------------------- (program_tail)
∅

Γ ⊢ head : ∅, Γ ⊢ tail : ∅
------------------------------- (program)
∅
