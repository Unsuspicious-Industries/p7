.git/
.github/
.dockerignore
.env
.env.*
!.env.example

# Local Python/build state
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.nix-pip/
.venv/
.venv-nix/
.vscode/
dist/
build/

# Local benchmark outputs and backups
artifact-output/
benchmarks/out/
backup/
evals/
final/
processed/
result/
unified/
vast_model_matrix/

# Runtime caches. Models are downloaded into mounted cache dirs at run time.
.cache/
**/.cache/
cache/
**/cache/
hf-cache/
**/hf-cache/
huggingface/
**/huggingface/
model-cache/
**/model-cache/
checkpoints/
**/checkpoints/
/models/

# Model/checkpoint weights should never be baked into the artifact image.
*.safetensors
**/*.safetensors
*.bin
**/*.bin
*.ckpt
**/*.ckpt
*.gguf
**/*.gguf
*.onnx
**/*.onnx
*.pt
**/*.pt
*.pth
**/*.pth
